{
  "listenHost": "127.0.0.1",
  "listenPort": 3566,
  "codexModel": "friend-router/text",
  "clientKeychainService": "com.friend-codex-router.client",
  "clientKeychainAccount": "default",
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "keychainService": "com.friend-codex-router.provider.deepseek"
    },
    "bailian": {
      "name": "Alibaba Bailian",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "keychainService": "com.friend-codex-router.provider.bailian"
    }
  },
  "textRoute": { "provider": "deepseek", "model": "deepseek-chat" },
  "visionRoute": { "provider": "bailian", "model": "qwen-vl-max" },
  "modelRoutes": {
    "friend-router/text": { "provider": "deepseek", "upstreamModel": "deepseek-chat" }
  },
  "cacheFile": "~/Library/Application Support/Friend Codex Router/vision-cache.json",
  "usageFile": "~/Library/Application Support/Friend Codex Router/usage.json",
  "usageWindow": "week",
  "modelPricing": {},
  "visionPromptVersion": "general-v1",
  "maxAutoVisionPerRequest": 1,
  "maxRequestBytes": 26214400,
  "maxImageBytes": 20971520,
  "visionTimeoutMs": 45000,
  "updateManifestURL": "",
  "updatePublicKeyBase64": "",
  "updateCheckIntervalSeconds": 900
}
